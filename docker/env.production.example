# کپی به ریشهٔ مخزن با نام .env قبل از docker compose:
#   cp docker/env.production.example .env

PUBLIC_HOST=sabad-yar.ir
PUBLIC_URL=https://sabad-yar.ir
CORS_ORIGIN=https://sabad-yar.ir,http://sabad-yar.ir,https://www.sabad-yar.ir,https://piiip.ir,http://piiip.ir,https://www.piiip.ir,https://piiip.ai,http://piiip.ai,https://www.piiip.ai,http://46.249.100.230
# ورود زیست‌سنجی موبایل؛ شناسه از دامنهٔ همان صفحه ساخته می‌شود
WEBAUTHN_RP_ID=sabad-yar.ir
WEBAUTHN_RP_NAME=پیپ
# مرورگر همان origin را صدا می‌زند (/api)؛ این مقدار در بیلد وب استفاده نمی‌شود
NEXT_PUBLIC_API_URL=

# فقط nginx روی اینترنت؛ 3000 و 3001 publish نمی‌شوند
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

POSTGRES_USER=sabadyar
POSTGRES_PASSWORD=sabadyar
POSTGRES_DB=sabadyar

# الزامی؛ هر کدام با openssl rand -hex 32 بسازید. با مقدار نمونه یا خالی، API بالا نمی‌آید.
# JWT_SECRET را هر وقت عوض کنید فقط همهٔ کاربران دوباره وارد می‌شوند.
JWT_SECRET=
# کلید رمزنگاری توکن‌های ذخیره‌شده. اگر سرور تا الان با مقدار نمونه کار کرده، برای چرخش:
# کلید تازه را اینجا بگذارید، مقدار قبلی (0123456789abcdef0123456789abcdef) را در LLM_TOKEN_ENCRYPTION_KEY_PREVIOUS،
# بعد توکن‌های مدل، System One، تلگرام، زرین‌پال و BRS را از تنظیمات ادمین دوباره ذخیره کنید.
LLM_TOKEN_ENCRYPTION_KEY=
LLM_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# تعداد پروکسی جلوی API برای خواندن آی‌پی واقعی: ۱ فقط nginx، ۲ اگر CDN جلوی nginx است
TRUSTED_PROXY_HOPS=1

PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=gpt-4o-mini
# مدل و صدای متن‌به‌صدا از تنظیمات ادمین، بخش ربات تلگرام، خوانده می‌شود.
# رونویسی یوتیوب؛ مدل در کد ثابت whisper-1 است و آدرس و کلید فقط از تنظیمات LLM ادمین می‌آید
SUBTITLE_FONT=/usr/share/fonts/vazirmatn/Vazirmatn-Regular.ttf
SUBTITLE_FONT_SIZE=22
SUBTITLE_MARGIN_V=40
SUBTITLE_OUTLINE=2
MAX_VIDEO_DURATION=1200
MAX_VIDEO_SIZE_MB=48
JOB_TIMEOUT_SEC=1500
TEMP_DIR=/tmp/jobs
# مدل‌های جایگزین هنگام ۴۲۹ (با ویرگول)
LLM_MODEL_FALLBACKS=

# نشانی و توکن بورس ایران از تنظیمات ادمین خوانده می‌شود.
# این کلید فقط تا وقتی توکن در تنظیمات خالی است به‌کار می‌رود.
BRS_API_KEY=
# نوع اوراق: 1=سهام+ETF+حق‌تقدم (پیش‌فرض)
BRS_API_TYPES=1
