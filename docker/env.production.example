#   cp docker/env.production.example .env

# آدرس عمومی سرور (مرورگر کاربر)
PUBLIC_HOST=46.249.100.230
CORS_ORIGIN=http://46.249.100.230:3000
NEXT_PUBLIC_API_URL=http://46.249.100.230:3001

WEB_HOST_PORT=3000
API_HOST_PORT=3001

POSTGRES_USER=sabadyar
POSTGRES_PASSWORD=sabadyar
