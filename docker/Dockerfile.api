# syntax=docker/dockerfile:1

FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN --mount=type=cache,target=/root/.npm \
    npm ci -w @sabadyar/api -w @sabadyar/shared --include-workspace-root --no-audit --no-fund

FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json /app/package-lock.json ./
COPY --from=deps /app/apps/api/package.json ./apps/api/
COPY --from=deps /app/apps/web/package.json ./apps/web/
COPY --from=deps /app/packages/shared/package.json ./packages/shared/
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN npm run build -w @sabadyar/shared \
  && npm run prisma:generate -w @sabadyar/api \
  && npm run build -w @sabadyar/api

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    API_PORT=3001 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SUBTITLE_FONT=/usr/share/fonts/vazirmatn/Vazirmatn-Regular.ttf \
    SUBTITLE_FONT_SIZE=22 \
    SUBTITLE_MARGIN_V=40 \
    SUBTITLE_OUTLINE=2 \
    TEMP_DIR=/tmp/jobs \
    JOB_TIMEOUT_SEC=1500

# اول خروجی بیلد، تا نصب ffmpeg با npm ci همزمان حافظه را پر نکند
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

RUN apk add --no-cache libc6-compat openssl wget ffmpeg fontconfig python3 postgresql-client \
  && wget -qO /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
  && chmod a+x /usr/local/bin/yt-dlp \
  && mkdir -p /usr/share/fonts/vazirmatn
COPY apps/api/src/telegram-assistant/fonts/Vazirmatn-Regular.ttf /usr/share/fonts/vazirmatn/Vazirmatn-Regular.ttf

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY --from=deps /app/node_modules ./node_modules
COPY docker/api-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
  && mkdir -p /app/apps/api/uploads/funds \
  && npx prisma generate --schema=/app/apps/api/prisma/schema.prisma

WORKDIR /app/apps/api
EXPOSE 3001
ENTRYPOINT ["/entrypoint.sh"]
