# --- Docker / سرور (پیش‌فرض برای docker compose) ---
# DATABASE_URL داخل compose برای سرویس api به‌صورت خودکار به db اشاره می‌کند.
# برای اجرای بدون Docker روی host:
DATABASE_URL="postgresql://sabadyar:sabadyar@localhost:5432/sabadyar?schema=public"

# SQLite فقط اگر Docker استفاده نمی‌کنید و provider را در schema به sqlite برگردانید:
# DATABASE_URL="file:./dev.db"

API_PORT=3001
# بدون Docker، API فقط روی localhost گوش می‌دهد (نه 0.0.0.0)
API_LISTEN_HOST="127.0.0.1"
JWT_SECRET="change-me-to-a-long-random-string"
LLM_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# توسعه محلی روی همان ماشین:
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# ورود با اثر انگشت/چهره روی موبایل (WebAuthn). روی IP خام کار نمی‌کند.
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_RP_NAME="پیپ"

# سرور با nginx. هر سه دامنه همین سایت را می‌دهند.
# PUBLIC_URL برای بازگشت از درگاه زرین‌پال یک نشانی ثابت می‌ماند
# PUBLIC_URL="https://sabad-yar.ir"
# CORS_ORIGIN="https://sabad-yar.ir,https://piiip.ir,https://piiip.ai"
# NEXT_PUBLIC_API_URL="https://sabad-yar.ir"

PLATFORM_LLM_BASE_URL="https://api.openai.com/v1"
PLATFORM_LLM_API_KEY=""
PLATFORM_LLM_MODEL="gpt-4o-mini"

# گفتار دستیار تلگرام روی همان baseUrl تنظیمات LLM (مسیر /audio/speech)
# اخبار روزانهٔ ربات مدل را از تنظیمات ادمین می‌گیرد (پیش‌فرض Gemini).
# صدای OpenAI: nova shimmer coral sage
# صدای Gemini: aoede و بقیهٔ نام‌های زنانه؛ nova برای Gemini فرستاده نمی‌شود
# TTS_MODEL="gpt-4o-mini-tts"
# TTS_VOICE="nova"

# رونویسی یوتیوب. مدل در کد ثابت است: gapgpt/whisper-1 و مسیر /v1/audio/transcriptions
# اگر خالی باشد از همان آدرس و کلید LLM استفاده می‌شود.
# GAPGPT_BASE_URL="https://api.example.com"
# GAPGPT_API_KEY=""
# SUBTITLE_FONT="/usr/share/fonts/vazirmatn/Vazirmatn-Regular.ttf"
# SUBTITLE_FONT_SIZE=22
# SUBTITLE_MARGIN_V=40
# SUBTITLE_OUTLINE=2
# MAX_VIDEO_DURATION=1200
# MAX_VIDEO_SIZE_MB=48
# JOB_TIMEOUT_SEC=1500
# TEMP_DIR="/tmp/jobs"

# برای سرور خارج ایران (مثلاً Contabo): کلید رایگان از https://brsapi.ir
BRS_API_KEY="BypmdCH3xNLte3rZHUvTeSPNCe5uqUYv"
BRS_API_TYPES="1"
