generator client {
  provider = "prisma-client-js"
}

datasource db {
  // برای Docker/production: postgresql
  // برای توسعه محلی بدون Docker می‌توانید موقتاً به sqlite برگردید
  provider = "postgresql"
}

enum AssetType {
  STOCK
  GOLD_ETF
  OPTION
  DEPOSIT
  FUND
  CASH
  PHYSICAL_GOLD
  PHYSICAL_USD
  INDEX
}

enum PortfolioStrategy {
  GROWTH
  VALUE
  INCOME
  HEDGED
  CONSERVATIVE
  CUSTOM
}

enum SnapshotKind {
  SUGGESTION
  REBALANCE
  MONTHLY_EVAL
  USER_ADJUSTED
}

enum PortfolioEventType {
  BUY
  SELL
  DEPOSIT_CASH
  WITHDRAW_CASH
  WEIGHT_EDIT
  ACCEPT_REBALANCE
  REJECT_REBALANCE
}

enum UserRole {
  ADMIN
  USER
  RESELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  /// کد معرف Reseller. فقط برای همین نقش ساخته می‌شود
  referralCode   String? @unique
  referralActive Boolean @default(true)
  /// درصد تخفیف شارژ کیف پول برای کسی که این کد را وارد کند
  discountPct    Int     @default(0)
  /// کاربری که این حساب را ساخته است
  resellerId     String?
  /// بازار اختیار معامله؛ پیش‌فرض بسته است و ادمین یا معرف آن را باز می‌کند
  optionsMarketAccess Boolean @default(false)
  /// پیشنهاد، آنالیز و بازچینش سبد با هوش مصنوعی
  aiPortfolioEnabled Boolean @default(true)
  /// گفتگو و بقیهٔ فراخوانی‌های مدل زبانی برای همین کاربر
  llmEnabled Boolean @default(true)
  /// موجودی کیف پول به ریال
  walletBalanceRial Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reseller User?  @relation("ResellerClients", fields: [resellerId], references: [id], onDelete: SetNull)
  clients  User[] @relation("ResellerClients")

  profile     UserProfile?
  llmSetting  LlmSetting?
  portfolios  Portfolio[]
  fundReports FundReport[]
  fundDefinitions FundDefinition[]
  fundTimelineInsights FundTimelineInsight[]
  portfolioChats PortfolioChatMessage[]
  lessons     Lesson[]
  aiTraces    AiTrace[]
  llmPrompts  LlmPromptTemplate[]
  economicNewsBatches EconomicNewsBatch[]
  marketChats MarketChatMessage[]
  webauthnCredentials WebAuthnCredential[]
  walletTransactions WalletTransaction[]
  walletPayments WalletPayment[]
  walletNotices WalletNotice[]
  intelligenceLogs IntelligenceLog[]
  aiQuota        AiUserQuota?
  aiUsageLogs    AiUsageLog[]
}

enum WalletTxKind {
  GATEWAY
  ADMIN
  TELEGRAM
  SUGGEST
  REBALANCE
  REFUND
}

enum WalletPaymentStatus {
  PENDING
  PAID
  FAILED
}

/** تنظیم سراسری کسر از کیف پول و درگاه زرین‌پال */
model WalletConfig {
  id                  String   @id @default("default")
  /// اگر خاموش باشد هیچ قابلیتی از کیف پول کسر نمی‌شود
  enabled             Boolean  @default(false)
  sandbox             Boolean  @default(false)
  merchantIdEncrypted String?
  telegramDailyRial   Int      @default(0)
  suggestRial         Int      @default(0)
  rebalanceRial       Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model WalletTransaction {
  id               String       @id @default(cuid())
  userId           String
  amountRial       Int
  kind             WalletTxKind
  balanceAfterRial Int
  note             String?
  createdAt        DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WalletPayment {
  id         String              @id @default(cuid())
  userId     String
  /// مبلغی که به کیف پول اضافه می‌شود
  amountRial Int
  /// مبلغ پرداختی درگاه پس از تخفیف کد معرف
  paidRial   Int                 @default(0)
  resellerId String?
  referralCode String?
  discountPct Int                @default(0)
  authority  String              @unique
  status     WalletPaymentStatus @default(PENDING)
  refId      String?
  createdAt  DateTime            @default(now())
  paidAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resellerId, paidAt])
}

model WalletNotice {
  id      String @id @default(cuid())
  userId  String
  feature String
  dateKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, dateKey])
}

/** نرخ هزینهٔ توکن و سهمیهٔ پیش‌فرض هوش مصنوعی */
model AiUsageConfig {
  id                  String   @id @default("default")
  /// ریال به ازای هر ۱۰۰۰ توکن ورودی
  promptRialPer1k     Float    @default(0)
  /// ریال به ازای هر ۱۰۰۰ توکن خروجی
  completionRialPer1k Float    @default(0)
  /// ۰ یعنی بدون سقف، مگر برای کاربر عدد جدا گذاشته شود
  defaultQuotaTokens  Int      @default(0)
  /// مصرف و سهمیه فقط بعد از این لحظه شمرده می‌شود؛ سوابق متنی می‌مانند
  resetAt             DateTime?
  updatedAt           DateTime @updatedAt
}

/** سقف توکن هر کاربر. ۰ یعنی بدون سقف. */
model AiUserQuota {
  userId      String   @id
  limitTokens Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** هر فراخوانی مدل زبانی. ok یعنی جواب گرفته شد؛ خطا هم با ok=false همین‌جا می‌ماند. */
model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  purpose          String
  section          String
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costRial         Int      @default(0)
  estimated        Boolean  @default(false)
  ok               Boolean  @default(true)
  /// پرامپت کامل فرستاده‌شده به مدل
  prompt           String   @default("")
  /// جواب مدل، یا متن خطا اگر ناموفق بوده
  response         String   @default("")
  dateKey          String
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([section, dateKey])
  @@index([dateKey])
}

/** کلید عبور دستگاه (اثر انگشت / چهره / PIN گوشی) برای ورود WebAuthn */
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String?
  friendlyName String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge, kind])
  @@index([expiresAt])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  riskTolerance           Int       @default(5)
  horizonMonths           Int       @default(12)
  notes                   String?
  investmentPreferencesFa String?
  constraintsFa           String?
  /// LOW | MEDIUM | HIGH — نیاز نقدشوندگی اعلام‌شده
  liquidityNeed           String?
  /// حداکثر افت قابل قبول به درصد
  maxDrawdownPct          Int?
  /// LOW | MEDIUM | HIGH
  inflationSensitivity    String?
  /// LOW | MEDIUM | HIGH
  fxSensitivity           String?
  objectiveFa             String?
  /// موبایل ایران نرمال‌شده مثل 09121234567
  mobilePhone             String?
  telegramChatId          String?
  telegramUsername        String?
  telegramLinkedAt        DateTime?
  /// نمودار و پیشنهاد بهبود سبد در پیام روزانه
  telegramPortfolioEnabled Boolean @default(true)
  /// اخبار و فرصت‌های سرمایه‌گذاری، همراه فایل صوتی
  telegramNewsEnabled      Boolean @default(true)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mobilePhone])
  @@index([telegramChatId])
}

model LlmSetting {
  id                   String  @id @default(cuid())
  userId               String  @unique
  baseUrl              String  @default("https://api.openai.com/v1")
  model                String  @default("gpt-4o-mini")
  /// شناسهٔ مدل System One برای تشکیل سبد. این مدل چت نیست.
  systemModel          String  @default("")
  systemOneBaseUrl     String  @default("https://system-one.dev/v1")
  systemOneTokenEncrypted String?
  /// سرویس جستجوی زنده (وب و X) برای اخبار؛ اگر نشانی یا کلید خالی باشد همان اتصال مدل زبانی استفاده می‌شود
  searchBaseUrl        String  @default("")
  searchModel          String  @default("")
  searchTokenEncrypted String?
  apiTokenEncrypted    String?
  usePlatformFallback  Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LlmPromptTemplate {
  id           String   @id @default(cuid())
  userId       String
  purpose      String
  systemPrompt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([userId])
}

model Instrument {
  id        String    @id @default(cuid())
  insCode   String?   @unique
  symbol    String
  nameFa    String
  assetType AssetType
  isActive  Boolean   @default(true)
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  priceBars     PriceBar[]
  snapshotItems SnapshotItem[]

  @@unique([symbol, assetType])
  @@index([assetType])
}

model PriceBar {
  id            String   @id @default(cuid())
  instrumentId  String
  tradeDate     DateTime
  lastPrice     Float?
  closePrice    Float?
  eps           Float?
  pe            Float?
  volume        Float?
  raw           Json?
  createdAt     DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, tradeDate])
  @@index([tradeDate])
}

model Portfolio {
  id           String            @id @default(cuid())
  userId       String
  name         String
  strategy     PortfolioStrategy
  capitalRial  Float
  cashRial     Float             @default(0)
  description       String?
  preferencesNoteFa String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots    PortfolioSnapshot[]
  events       PortfolioEvent[]
  chatMessages PortfolioChatMessage[]
  intelligenceLogs IntelligenceLog[]

  @@index([userId])
}

model PortfolioSnapshot {
  id                 String       @id @default(cuid())
  portfolioId        String
  kind               SnapshotKind
  strategySummaryFa  String?
  asOfDate           DateTime     @default(now())
  totalValueRial     Float?
  performancePct     Float?
  meta               Json?
  createdAt          DateTime     @default(now())

  portfolio Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  items     SnapshotItem[]

  @@index([portfolioId])
}

model SnapshotItem {
  id         String    @id @default(cuid())
  snapshotId String
  instrumentId String?
  symbol     String
  assetType  AssetType
  weightPct  Float
  quantity   Float
  amountRial Float
  reasonFa   String
  /// قیمت لحظه‌ای/بازار در زمان ساخت اسنپ‌شات
  unitPrice  Float?
  /// میانگین قیمت خرید (برای سود/زیان در طول زمان)
  avgBuyPrice Float?

  snapshot   PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  instrument Instrument?       @relation(fields: [instrumentId], references: [id])

  @@index([snapshotId])
}

model PortfolioEvent {
  id          String             @id @default(cuid())
  portfolioId String
  type        PortfolioEventType
  payload     Json
  noteFa      String?
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status      String             @default("active")
  createdAt   DateTime           @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([portfolioId, status])
}

model FundDefinition {
  id          String   @id @default(cuid())
  userId      String
  nameFa      String
  symbolCode  String?
  description String?
  /// آدرس سایت صندوق؛ اختیاری
  websiteUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  FundReport[]
  insights FundTimelineInsight[]
  holdings FundHolding[]

  @@unique([userId, nameFa])
  @@index([userId])
}

model FundReport {
  id                 String   @id @default(cuid())
  userId             String
  fundDefinitionId   String?
  fundName           String
  reportMonth        String
  reportYear         Int?
  reportMonthNum     Int?
  filePath           String
  extractedText      String?
  extractedSheetsJson Json?
  guessedStrategyFa      String?
  rating                 Float?
  managerTechnicalScore  Float?
  riskAppetiteScore      Float?
  professionalismScore   Float?
  useInSuggestions       Boolean  @default(false)
  analysisJson       Json?
  /// pending | running | done | failed — آنالیز در صف پس‌زمینه انجام می‌شود
  analysisStatus     String   @default("done")
  analysisError      String?
  /// اگر گزارش از نشانی وب گرفته شده باشد
  sourceUrl          String?
  createdAt          DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition? @relation(fields: [fundDefinitionId], references: [id], onDelete: SetNull)
  lessons        Lesson[]
  holdings       FundHolding[]

  @@index([userId])
  @@index([fundDefinitionId])
}

/// دارایی‌های گزارش ماهانه صندوق (موجود / خرید / فروش)
model FundHolding {
  id               String   @id @default(cuid())
  fundReportId     String
  fundDefinitionId String?
  userId           String
  /// نماد نرمال‌شده برای روند (مثلاً فولاد)
  symbol           String
  nameFa           String
  /// STOCK | BOND | GOLD | CASH | DEPOSIT | FUND | OTHER
  assetKind        String   @default("STOCK")
  /// HELD | BOUGHT | SOLD
  action           String   @default("HELD")
  weightPct        Float?
  amountRial       Float?
  quantity         Float?
  reportYear       Int?
  reportMonthNum   Int?
  createdAt        DateTime @default(now())

  fundReport     FundReport      @relation(fields: [fundReportId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition? @relation(fields: [fundDefinitionId], references: [id], onDelete: SetNull)

  @@index([fundReportId])
  @@index([fundDefinitionId, symbol])
  @@index([userId, symbol])
  @@index([symbol])
}

model FundTimelineInsight {
  id               String   @id @default(cuid())
  userId           String
  fundDefinitionId String
  fromReportId     String?
  toReportId       String?
  summaryFa        String
  strategyChangeFa String?
  holdingsDiffFa   String?
  llmReasoningFa   String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition @relation(fields: [fundDefinitionId], references: [id], onDelete: Cascade)

  @@index([fundDefinitionId])
  @@index([userId])
}

model PortfolioChatMessage {
  id          String   @id @default(cuid())
  portfolioId String
  userId      String
  role        String
  contentFa   String
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status      String   @default("active")
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([userId])
  @@index([portfolioId, status])
}

model MarketChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  contentFa String
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status    String   @default("active")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Lesson {
  id           String   @id @default(cuid())
  userId       String
  fundReportId String?
  titleFa      String
  bodyFa       String
  source       String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundReport FundReport? @relation(fields: [fundReportId], references: [id])

  @@index([userId])
}

model MacroSnapshot {
  id                String   @id @default(cuid())
  asOfDate          DateTime
  inflationPct      Float?
  interestRatePct   Float?
  usdIrr            Float?
  geoRiskScore      Int?
  summaryFa         String?
  newsJson          Json?
  createdAt         DateTime @default(now())

  @@unique([asOfDate])
}

model EconomicNewsBatch {
  id            String   @id @default(cuid())
  userId        String
  newsDateKey   String
  summaryFa     String?
  sourceNoteFa  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items EconomicNewsItem[]

  @@unique([userId, newsDateKey])
  @@index([userId])
}

model EconomicNewsItem {
  id              String   @id @default(cuid())
  batchId         String
  userId          String
  titleFa         String
  summaryFa       String
  marketImpactFa  String?
  impactDirection String?
  relevanceScore  Float?
  sectorsFa       String?
  xSourceHintFa   String?
  /// macro | opportunity
  category        String?
  /// ipo | auto_sale | coin_auction | fx_auction | arbitrage | growth | sukuk | housing | fund | deposit | other
  opportunityKind String?
  participateHowFa String?
  deadlineFa      String?
  officialSourceFa String?
  isRetailActionable Boolean @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  batch EconomicNewsBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([userId])
}

model AiTrace {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String
  prompt    String
  response  String
  model     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose])
}

/** خطای مدل زبانی، بک‌اند و سیستم برای نمایش در تنظیمات ادمین */
model LlmErrorLog {
  id         String   @id @default(cuid())
  userId     String?
  purpose    String?
  statusCode Int?
  message    String
  detail     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/** تنظیمات تک‌ردیفی ربات تلگرام (توکن رمزنگاری‌شده). نام کاربری پیش‌فرض: sabadyaar_bot */
model TelegramBotConfig {
  id                String   @id @default("default")
  botNameFa         String?
  botUsername       String?
  botTokenEncrypted String?
  /// نشانی پایهٔ گفتار. خالی یعنی اتصال مدل زبانی مدیر
  ttsBaseUrl        String   @default("")
  /// توکن گفتار، جدا از توکن ربات. خالی یعنی همان کلید مدل زبانی مدیر
  ttsApiTokenEncrypted String?
  /// مدل متن‌به‌صدا برای فایل صوتی اخبار روزانه
  ttsModel          String   @default("gpt-4o-mini-tts")
  /// نام صدای گفتار، مثلاً alloy
  ttsVoice          String   @default("alloy")
  /// ساعت ارسال به وقت تهران
  sendHour          Int      @default(8)
  sendMinute        Int      @default(30)
  /// روزهای هفته؛ ۰ یکشنبه تا ۶ شنبه
  sendWeekdays      Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  enabled           Boolean  @default(true)
  lastUpdateId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/** ربات دوطرفهٔ دستیار (سؤال، URL، PDF، یوتیوب) — جدا از ربات یک‌طرفهٔ خلاصهٔ صبح */
model TelegramAssistantConfig {
  id                String   @id @default("default")
  botNameFa         String?
  botUsername       String?
  botTokenEncrypted String?
  enabled           Boolean  @default(true)
  lastUpdateId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramDigestLog {
  id              String   @id @default(cuid())
  dateKey         String   @unique
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  skippedReasonFa String?
  createdAt       DateTime @default(now())
}

/** متن گفتاری و فایل صوتی مشترک اخبار تلگرام؛ هر روز فقط یک‌بار ساخته می‌شود */
model TelegramSharedDigest {
  dateKey     String   @id
  voiceScript String   @db.Text
  voiceAudio  Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** خبرنامهٔ شخصی مدیر: ربات تلگرام جدا، هر چند ساعت پست‌های فنی X در سه موضوع */
model PersonalDigestConfig {
  id                String   @id @default("default")
  botUsername       String?
  botTokenEncrypted String?
  /// شناسهٔ چت تلگرام مدیر (عدد)
  chatId            String?
  /// دورهٔ تناوب به ساعت؛ مثلاً ۶ یعنی هر ۶ ساعت
  intervalHours     Int      @default(6)
  /// ساعت شروع شمارش دوره به وقت تهران (۰ تا ۲۳)
  startHour         Int      @default(0)
  sendMinute        Int      @default(0)
  /// سرفصل‌ها: [{ titleFa, focusFa, itemsCount }]؛ خالی یعنی سرفصل‌های پیش‌فرض
  topics            Json?
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/** هر نوبت خبرنامهٔ شخصی؛ slotKey یکتا جلوی ارسال دوباره در همان نوبت را می‌گیرد */
model PersonalDigestRun {
  id        String   @id @default(cuid())
  slotKey   String   @unique
  manual    Boolean  @default(false)
  status    String   @default("running")
  itemCount Int      @default(0)
  /// عنوان‌های فرستاده‌شده تا نوبت بعد تکرار نشوند
  titles    String[] @default([])
  errorFa   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/** تنظیمات تک‌ردیفی آدرس API قیمت لحظه‌ای دلار و طلا */
model SpotPriceApiConfig {
  id        String   @id @default("default")
  uri       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** قیمت روزانه دلار و طلا (به وقت ایران) */
model SpotPriceDaily {
  id             String   @id @default(cuid())
  /// کلید تاریخ شمسی/میلادی تهران به صورت YYYY-MM-DD
  dateKey        String   @unique
  asOfDate       DateTime
  usdIrr         Float?
  /// قیمت تقریبی هر گرم طلا (۱۸ عیار) به ریال
  goldGramRial   Float?
  sourceRaw      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([asOfDate])
}

/** ساعت به‌روزرسانی اخبار ایران، اقتصاد دنیا و بازار سهام به وقت تهران */
model ContentRefreshSchedule {
  id              String   @id @default("default")
  iranNewsHour    Int      @default(8)
  iranNewsMinute  Int      @default(0)
  worldHour       Int      @default(7)
  worldMinute     Int      @default(0)
  /// پیش‌فرض ۲۲:۰۰ تهران، همان زمان قبلی به‌روزرسانی بازار
  marketHour      Int      @default(22)
  marketMinute    Int      @default(0)
  /// فاصلهٔ خواندن قیمت دلار و طلا در پس‌زمینه، به ساعت
  spotIntervalHours Int    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/** آخرین نتیجهٔ به‌روزرسانی بازار. خطا یعنی منبع سهام نباید به‌روز دیده شود. */
model MarketIngestStatus {
  id         String    @id @default("latest")
  ok         Boolean   @default(true)
  message    String    @default("")
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

/// غربال روزانهٔ System One روی همهٔ سهم‌های معامله‌شده؛ پیشنهاد هر کاربر فقط از سهم‌های برتر همین جدول می‌آید.
model StockScreenDaily {
  id          String   @id @default(cuid())
  tradeDate   DateTime
  symbol      String
  /// احتمال حضور در سبد از ۰ تا ۱
  probability Float
  /// ارقامی که مدل همان روز دید
  facts       Json?
  createdAt   DateTime @default(now())

  @@unique([tradeDate, symbol])
  @@index([tradeDate, probability])
}

/** نشانی و توکن BrsApi برای بورس ایران. توکن رمزنگاری‌شده است. */
model IranMarketApiConfig {
  id                 String   @id @default("default")
  baseUrl            String   @default("https://Api.BrsApi.ir")
  apiTokenEncrypted  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/** نشانی API بیت‌پین و یاهو فایننس برای اقتصاد دنیا */
model WorldSourceApiConfig {
  id               String   @id @default("default")
  bitpinMarketsUrl String   @default("https://api.bitpin.ir/v1/mkt/markets/")
  yahooQuoteUrl    String   @default("https://query1.finance.yahoo.com/v7/finance/quote")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/** آخرین همگام‌سازی بازارهای جهانی (بیت‌پین) */
model WorldMarketRefresh {
  id           String   @id @default("latest")
  fetchedAt    DateTime
  dateKey      String
  symbolCount  Int
  sourceUrl    String
  /// خلاصهٔ اخبار کلان جهان همان همگام‌سازی
  xSummaryFa   String?
  /// رسانه‌ها و کانال‌هایی که خبر از آن‌ها خوانده شد
  xSourceNoteFa String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// حداکثر ۵ خبر مهم اقتصاد کلان جهان (به‌ویژه آمریکا) اثرگذار بر نفت، طلا، دلار، فلزات و رمزارز
model WorldMacroNews {
  id              String   @id @default(cuid())
  dateKey         String
  titleFa         String
  summaryFa       String
  /// اثر بر نفت، طلا، دلار، فلزات یا رمزارز
  assetImpactFa   String?
  /// اثر محتمل بر اقتصاد کلان یا بورس ایران
  iranImpactFa    String?
  /// دارایی‌های اثرپذیر: نفت، طلا، دلار، مس، بیت‌کوین
  assetsFa        String?
  /// bullish | bearish | neutral | mixed
  impactDirection String?
  relevanceScore  Float?
  /// رسانه یا کانال معتبر منتشرکننده
  sourceHintFa    String?
  sortOrder       Int      @default(0)
  fetchedAt       DateTime
  createdAt       DateTime @default(now())

  @@index([dateKey])
  @@index([sortOrder])
}

/** آخرین واکشی اطلاعیه‌های کدال هر نماد؛ در هر روز تهران فقط یک‌بار کرال می‌شود */
model CodalNoticeFetch {
  symbol    String   @id
  dateKey   String
  fetchedAt DateTime
}

/** ده اطلاعیهٔ آخر کدال هر نماد، با متن استخراج‌شده از صفحهٔ اطلاعیه */
model CodalNotice {
  id            String   @id @default(cuid())
  symbol        String
  tracingNo     Int
  titleFa       String
  letterCode    String?
  /// زمان انتشار به همان شکل شمسی کدال
  publishedAtFa String
  url           String
  hasHtml       Boolean  @default(false)
  bodyText      String?
  sortOrder     Int      @default(0)
  fetchedAt     DateTime
  createdAt     DateTime @default(now())

  @@index([symbol, sortOrder])
}

/** پنج سیگنال خرید/فروش از فضای X روی نمادهای اقتصاد دنیا */
model WorldMarketSignal {
  id             String   @id @default(cuid())
  /// BUY | SELL
  side           String
  marketCode     String
  baseCode       String
  baseTitleFa    String
  titleFa        String
  reasonFa       String
  strength       Float
  xSourceHintFa  String?
  languagesFa    String?
  sortOrder      Int      @default(0)
  fetchedAt      DateTime
  createdAt      DateTime @default(now())

  @@index([fetchedAt])
  @@index([sortOrder])
}

/** نمادهای بازار جهانی — هر بار همگام‌سازی جایگزین آخرین وضعیت می‌شود */
model WorldMarket {
  id             String   @id @default(cuid())
  bitpinId       Int
  code           String   @unique
  title          String
  titleFa        String
  baseCode       String
  baseTitle      String
  baseTitleFa    String
  baseImageUrl   String?
  baseColor      String?
  quoteCode      String
  quoteTitle     String
  quoteTitleFa   String
  price          String
  priceNum       Float?
  changePct      Float?
  high24h        String?
  low24h         String?
  volume24h      String?
  volumeNum      Float?
  marketCap      String?
  circulating    String?
  allTimeHigh    String?
  tradable       Boolean  @default(true)
  suspended      Boolean  @default(false)
  otcTradable    Boolean  @default(false)
  comingSoon     Boolean  @default(false)
  tagsFa         String?
  /// قیمت هم‌ارز Yahoo Finance به واحد همان quote
  yahooSymbol    String?
  yahooPriceNum  Float?
  /// بیت‌پین − یاهو (همان واحد)
  diffAbs        Float?
  /// درصد اختلاف نسبت به یاهو: (بیت‌پین − یاهو) / یاهو × ۱۰۰
  diffPct        Float?
  fetchedAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([quoteCode])
  @@index([volumeNum])
  @@index([changePct])
  @@index([baseCode])
}

/** آزمایش گراف فارکس — اسنپ‌شات نرخ جفت‌ارزها با زمان */
model ForexSnapshot {
  id           String   @id @default(cuid())
  capturedAt   DateTime
  source       String
  nodeCount    Int
  edgeCount    Int
  pairCount    Int
  analysisJson Json?
  createdAt    DateTime @default(now())

  nodes ForexGraphNode[]
  edges ForexGraphEdge[]

  @@index([capturedAt])
}

model ForexGraphNode {
  id         String @id @default(cuid())
  snapshotId String
  code       String
  nameFa     String
  /// FIAT | CRYPTO | METAL
  kind       String

  snapshot ForexSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, code])
  @@index([snapshotId])
}

/** رژیم بازار محاسبه‌شده از دادهٔ موجود؛ هر روز تهران یک ردیف */
model MarketRegimeLog {
  dateKey    String   @id
  regime     String
  /// null یعنی نشانهٔ کافی نبوده و عدد اطمینان ساخته نشده
  confidence Float?
  summaryFa  String
  drivers    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/** تاریخچهٔ برنامهٔ تخصیص قطعی؛ حذف نمی‌شود */
model IntelligenceLog {
  id          String   @id @default(cuid())
  userId      String
  portfolioId String
  dateKey     String
  regime      String
  payload     Json
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, dateKey])
  @@index([userId, createdAt])
}

/** کارمزد خرید و فروش به درصد از مبلغ معامله */
model TradeFeeConfig {
  id                  String   @id @default("default")
  stockBuyPct         Float    @default(0)
  stockSellPct        Float    @default(0)
  physicalUsdBuyPct   Float    @default(0)
  physicalUsdSellPct  Float    @default(0)
  physicalGoldBuyPct  Float    @default(0)
  physicalGoldSellPct Float    @default(0)
  updatedAt           DateTime @updatedAt
}

/** روشن یا خاموش بودن ورود با موبایل در مسیر جدا */
model MobileLoginConfig {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/** ثبت آی‌پی، موقعیت و شمارهٔ موبایل برای ورود با موبایل */
model MobileLogin {
  id          String   @id @default(cuid())
  ip          String?
  location    String?
  mobilePhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([mobilePhone])
  @@map("mobilelogin")
}

model ForexGraphEdge {
  id          String  @id @default(cuid())
  snapshotId  String
  fromCode    String
  toCode      String
  rate        Float
  pairSymbol  String
  yahooSymbol String?
  source      String
  inverted    Boolean @default(false)
  bid         Float?
  ask         Float?
  spreadPct   Float?

  snapshot ForexSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, fromCode])
}
