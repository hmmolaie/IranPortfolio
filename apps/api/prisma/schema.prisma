generator client {
  provider = "prisma-client-js"
}

datasource db {
  // برای Docker/production: postgresql
  // برای توسعه محلی بدون Docker می‌توانید موقتاً به sqlite برگردید
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  STOCK
  GOLD_ETF
  OPTION
  DEPOSIT
  FUND
  CASH
  PHYSICAL_GOLD
  PHYSICAL_USD
  INDEX
}

enum PortfolioStrategy {
  GROWTH
  VALUE
  INCOME
  HEDGED
  CONSERVATIVE
  CUSTOM
}

enum SnapshotKind {
  SUGGESTION
  REBALANCE
  MONTHLY_EVAL
  USER_ADJUSTED
}

enum PortfolioEventType {
  BUY
  SELL
  DEPOSIT_CASH
  WITHDRAW_CASH
  WEIGHT_EDIT
  ACCEPT_REBALANCE
  REJECT_REBALANCE
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile     UserProfile?
  llmSetting  LlmSetting?
  portfolios  Portfolio[]
  fundReports FundReport[]
  fundDefinitions FundDefinition[]
  fundTimelineInsights FundTimelineInsight[]
  portfolioChats PortfolioChatMessage[]
  lessons     Lesson[]
  aiTraces    AiTrace[]
  llmPrompts  LlmPromptTemplate[]
  economicNewsBatches EconomicNewsBatch[]
  marketChats MarketChatMessage[]
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  riskTolerance           Int       @default(5)
  horizonMonths           Int       @default(12)
  notes                   String?
  investmentPreferencesFa String?
  constraintsFa           String?
  /// موبایل ایران نرمال‌شده مثل 09121234567
  mobilePhone             String?
  telegramChatId          String?
  telegramUsername        String?
  telegramLinkedAt        DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mobilePhone])
  @@index([telegramChatId])
}

model LlmSetting {
  id                   String  @id @default(cuid())
  userId               String  @unique
  baseUrl              String  @default("https://api.openai.com/v1")
  model                String  @default("gpt-4o-mini")
  apiTokenEncrypted    String?
  usePlatformFallback  Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LlmPromptTemplate {
  id           String   @id @default(cuid())
  userId       String
  purpose      String
  systemPrompt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([userId])
}

model Instrument {
  id        String    @id @default(cuid())
  insCode   String?   @unique
  symbol    String
  nameFa    String
  assetType AssetType
  isActive  Boolean   @default(true)
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  priceBars     PriceBar[]
  snapshotItems SnapshotItem[]

  @@unique([symbol, assetType])
  @@index([assetType])
}

model PriceBar {
  id            String   @id @default(cuid())
  instrumentId  String
  tradeDate     DateTime
  lastPrice     Float?
  closePrice    Float?
  eps           Float?
  pe            Float?
  volume        Float?
  raw           Json?
  createdAt     DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, tradeDate])
  @@index([tradeDate])
}

model Portfolio {
  id           String            @id @default(cuid())
  userId       String
  name         String
  strategy     PortfolioStrategy
  capitalRial  Float
  cashRial     Float             @default(0)
  description       String?
  preferencesNoteFa String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots    PortfolioSnapshot[]
  events       PortfolioEvent[]
  chatMessages PortfolioChatMessage[]

  @@index([userId])
}

model PortfolioSnapshot {
  id                 String       @id @default(cuid())
  portfolioId        String
  kind               SnapshotKind
  strategySummaryFa  String?
  asOfDate           DateTime     @default(now())
  totalValueRial     Float?
  performancePct     Float?
  meta               Json?
  createdAt          DateTime     @default(now())

  portfolio Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  items     SnapshotItem[]

  @@index([portfolioId])
}

model SnapshotItem {
  id         String    @id @default(cuid())
  snapshotId String
  instrumentId String?
  symbol     String
  assetType  AssetType
  weightPct  Float
  quantity   Float
  amountRial Float
  reasonFa   String
  /// قیمت لحظه‌ای/بازار در زمان ساخت اسنپ‌شات
  unitPrice  Float?
  /// میانگین قیمت خرید (برای سود/زیان در طول زمان)
  avgBuyPrice Float?

  snapshot   PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  instrument Instrument?       @relation(fields: [instrumentId], references: [id])

  @@index([snapshotId])
}

model PortfolioEvent {
  id          String             @id @default(cuid())
  portfolioId String
  type        PortfolioEventType
  payload     Json
  noteFa      String?
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status      String             @default("active")
  createdAt   DateTime           @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([portfolioId, status])
}

model FundDefinition {
  id          String   @id @default(cuid())
  userId      String
  nameFa      String
  symbolCode  String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  FundReport[]
  insights FundTimelineInsight[]
  holdings FundHolding[]

  @@unique([userId, nameFa])
  @@index([userId])
}

model FundReport {
  id                 String   @id @default(cuid())
  userId             String
  fundDefinitionId   String?
  fundName           String
  reportMonth        String
  reportYear         Int?
  reportMonthNum     Int?
  filePath           String
  extractedText      String?
  extractedSheetsJson Json?
  guessedStrategyFa      String?
  rating                 Float?
  managerTechnicalScore  Float?
  riskAppetiteScore      Float?
  professionalismScore   Float?
  useInSuggestions       Boolean  @default(false)
  analysisJson       Json?
  createdAt          DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition? @relation(fields: [fundDefinitionId], references: [id], onDelete: SetNull)
  lessons        Lesson[]
  holdings       FundHolding[]

  @@index([userId])
  @@index([fundDefinitionId])
}

/// دارایی‌های گزارش ماهانه صندوق (موجود / خرید / فروش)
model FundHolding {
  id               String   @id @default(cuid())
  fundReportId     String
  fundDefinitionId String?
  userId           String
  /// نماد نرمال‌شده برای روند (مثلاً فولاد)
  symbol           String
  nameFa           String
  /// STOCK | BOND | GOLD | CASH | DEPOSIT | FUND | OTHER
  assetKind        String   @default("STOCK")
  /// HELD | BOUGHT | SOLD
  action           String   @default("HELD")
  weightPct        Float?
  amountRial       Float?
  quantity         Float?
  reportYear       Int?
  reportMonthNum   Int?
  createdAt        DateTime @default(now())

  fundReport     FundReport      @relation(fields: [fundReportId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition? @relation(fields: [fundDefinitionId], references: [id], onDelete: SetNull)

  @@index([fundReportId])
  @@index([fundDefinitionId, symbol])
  @@index([userId, symbol])
  @@index([symbol])
}

model FundTimelineInsight {
  id               String   @id @default(cuid())
  userId           String
  fundDefinitionId String
  fromReportId     String?
  toReportId       String?
  summaryFa        String
  strategyChangeFa String?
  holdingsDiffFa   String?
  llmReasoningFa   String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundDefinition FundDefinition @relation(fields: [fundDefinitionId], references: [id], onDelete: Cascade)

  @@index([fundDefinitionId])
  @@index([userId])
}

model PortfolioChatMessage {
  id          String   @id @default(cuid())
  portfolioId String
  userId      String
  role        String
  contentFa   String
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status      String   @default("active")
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([userId])
  @@index([portfolioId, status])
}

model MarketChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  contentFa String
  /// active = نمایش به کاربر · hidden = پاک‌شده از دید کاربر (در DB می‌ماند)
  status    String   @default("active")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Lesson {
  id           String   @id @default(cuid())
  userId       String
  fundReportId String?
  titleFa      String
  bodyFa       String
  source       String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundReport FundReport? @relation(fields: [fundReportId], references: [id])

  @@index([userId])
}

model MacroSnapshot {
  id                String   @id @default(cuid())
  asOfDate          DateTime
  inflationPct      Float?
  interestRatePct   Float?
  usdIrr            Float?
  geoRiskScore      Int?
  summaryFa         String?
  newsJson          Json?
  createdAt         DateTime @default(now())

  @@unique([asOfDate])
}

model EconomicNewsBatch {
  id            String   @id @default(cuid())
  userId        String
  newsDateKey   String
  summaryFa     String?
  sourceNoteFa  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items EconomicNewsItem[]

  @@unique([userId, newsDateKey])
  @@index([userId])
}

model EconomicNewsItem {
  id              String   @id @default(cuid())
  batchId         String
  userId          String
  titleFa         String
  summaryFa       String
  marketImpactFa  String?
  impactDirection String?
  relevanceScore  Float?
  sectorsFa       String?
  xSourceHintFa   String?
  /// macro | opportunity
  category        String?
  /// ipo | auto_sale | coin_auction | sukuk | housing | fund | deposit | other
  opportunityKind String?
  participateHowFa String?
  deadlineFa      String?
  officialSourceFa String?
  isRetailActionable Boolean @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  batch EconomicNewsBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([userId])
}

model AiTrace {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String
  prompt    String
  response  String
  model     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose])
}

/** تنظیمات تک‌ردیفی ربات تلگرام (توکن رمزنگاری‌شده). نام کاربری پیش‌فرض: sabadyaar_bot */
model TelegramBotConfig {
  id                String   @id @default("default")
  botNameFa         String?
  botUsername       String?
  botTokenEncrypted String?
  enabled           Boolean  @default(true)
  lastUpdateId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/** ربات دوطرفهٔ دستیار (سؤال، URL، PDF، یوتیوب) — جدا از ربات یک‌طرفهٔ خلاصهٔ صبح */
model TelegramAssistantConfig {
  id                String   @id @default("default")
  botNameFa         String?
  botUsername       String?
  botTokenEncrypted String?
  enabled           Boolean  @default(true)
  lastUpdateId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramDigestLog {
  id              String   @id @default(cuid())
  dateKey         String   @unique
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  skippedReasonFa String?
  createdAt       DateTime @default(now())
}

/** تنظیمات تک‌ردیفی آدرس API قیمت لحظه‌ای دلار و طلا */
model SpotPriceApiConfig {
  id        String   @id @default("default")
  uri       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** قیمت روزانه دلار و طلا (به وقت ایران) */
model SpotPriceDaily {
  id             String   @id @default(cuid())
  /// کلید تاریخ شمسی/میلادی تهران به صورت YYYY-MM-DD
  dateKey        String   @unique
  asOfDate       DateTime
  usdIrr         Float?
  /// قیمت تقریبی هر گرم طلا (۱۸ عیار) به ریال
  goldGramRial   Float?
  sourceRaw      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([asOfDate])
}

/** آخرین همگام‌سازی بازارهای جهانی (بیت‌پین) */
model WorldMarketRefresh {
  id           String   @id @default("latest")
  fetchedAt    DateTime
  dateKey      String
  symbolCount  Int
  sourceUrl    String
  xSummaryFa   String?
  xSourceNoteFa String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/** پنج سیگنال خرید/فروش از فضای X روی نمادهای اقتصاد دنیا */
model WorldMarketSignal {
  id             String   @id @default(cuid())
  /// BUY | SELL
  side           String
  marketCode     String
  baseCode       String
  baseTitleFa    String
  titleFa        String
  reasonFa       String
  strength       Float
  xSourceHintFa  String?
  languagesFa    String?
  sortOrder      Int      @default(0)
  fetchedAt      DateTime
  createdAt      DateTime @default(now())

  @@index([fetchedAt])
  @@index([sortOrder])
}

/** نمادهای بازار جهانی — هر بار همگام‌سازی جایگزین آخرین وضعیت می‌شود */
model WorldMarket {
  id             String   @id @default(cuid())
  bitpinId       Int
  code           String   @unique
  title          String
  titleFa        String
  baseCode       String
  baseTitle      String
  baseTitleFa    String
  baseImageUrl   String?
  baseColor      String?
  quoteCode      String
  quoteTitle     String
  quoteTitleFa   String
  price          String
  priceNum       Float?
  changePct      Float?
  high24h        String?
  low24h         String?
  volume24h      String?
  volumeNum      Float?
  marketCap      String?
  circulating    String?
  allTimeHigh    String?
  tradable       Boolean  @default(true)
  suspended      Boolean  @default(false)
  otcTradable    Boolean  @default(false)
  comingSoon     Boolean  @default(false)
  tagsFa         String?
  fetchedAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([quoteCode])
  @@index([volumeNum])
  @@index([changePct])
  @@index([baseCode])
}

/** آزمایش گراف فارکس — اسنپ‌شات نرخ جفت‌ارزها با زمان */
model ForexSnapshot {
  id           String   @id @default(cuid())
  capturedAt   DateTime
  source       String
  nodeCount    Int
  edgeCount    Int
  pairCount    Int
  analysisJson Json?
  createdAt    DateTime @default(now())

  nodes ForexGraphNode[]
  edges ForexGraphEdge[]

  @@index([capturedAt])
}

model ForexGraphNode {
  id         String @id @default(cuid())
  snapshotId String
  code       String
  nameFa     String
  /// FIAT | CRYPTO | METAL
  kind       String

  snapshot ForexSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, code])
  @@index([snapshotId])
}

model ForexGraphEdge {
  id          String  @id @default(cuid())
  snapshotId  String
  fromCode    String
  toCode      String
  rate        Float
  pairSymbol  String
  yahooSymbol String?
  source      String
  inverted    Boolean @default(false)
  bid         Float?
  ask         Float?
  spreadPct   Float?

  snapshot ForexSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, fromCode])
}
